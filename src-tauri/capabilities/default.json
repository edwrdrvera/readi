{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window. Book content runs in blob: frames and never receives these.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-set-focus",
    "core:window:allow-set-size",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "opener:allow-open-url"
  ]
}
