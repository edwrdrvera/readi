{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Readi",
  "version": "0.1.0",
  "identifier": "dev.readi.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Readi",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 20, "y": 29 },
        "width": 1000,
        "height": 760,
        "minWidth": 480,
        "minHeight": 400,
        "dragDropEnabled": true,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline' blob:",
        "img-src": "'self' blob: data: book:",
        "font-src": "'self' blob: data:",
        "media-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost book: blob:",
        "frame-src": "blob:",
        "child-src": "blob:",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "epub"
        ],
        "name": "EPUB Book",
        "role": "Viewer",
        "mimeType": "application/epub+zip",
        "contentTypes": [
          "org.idpf.epub-container"
        ]
      },
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF Document",
        "role": "Viewer",
        "mimeType": "application/pdf",
        "contentTypes": [
          "com.adobe.pdf"
        ]
      }
    ]
  }
}
